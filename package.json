{
  "name": "agentwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heartbeat monitor for cron jobs and AI agents",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "vite build --config web/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "dry-run": "npm run build:web && wrangler deploy --dry-run",
    "types": "wrangler types",
    "test": "mkdir -p web/dist && vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply agentwatch --local",
    "migrate:remote": "wrangler d1 migrations apply agentwatch --remote"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
