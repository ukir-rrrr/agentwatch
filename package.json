{
  "name": "agentwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heartbeat monitor for cron jobs and AI agents",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply agentwatch --local",
    "migrate:remote": "wrangler d1 migrations apply agentwatch --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
